<?xml version="1.0"?>
<package format="3">
  <name>project3_odometry</name>
  <version>0.1.0</version>
  <description>ROS 2 odometry estimation and transform broadcasting for the AUROVIA Ackermann vehicle.</description>
  <maintainer email="akinkunmiakindolapo@gmail.com">Akinkunmi Abdullateef Akindolapo</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
