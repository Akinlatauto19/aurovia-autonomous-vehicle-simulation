<?xml version="1.0"?>
<launch>

    <include file="$(find-pkg-share audibot_gazebo)/launch/gazebo_bringup.launch.py">
        <arg name="robot_sdf_file"
             value="$(find-pkg-share audibot_description)/models/blue_audibot/model.sdf" />

        <arg name="world_sdf_file"
             value="$(find-pkg-share audibot_gazebo)/worlds/project3_blue_world.sdf" />

        <arg name="gz_bridge_file"
             value="$(find-pkg-share audibot_gazebo)/config/ros_gz_bridge.yaml" />

        <arg name="verbose" value="true" />
        <arg name="start_paused" value="false" />
    </include>

    <node pkg="project3_odometry"
          exec="odometry_node"
          name="project3_odometry"
          output="screen">
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="rqt_publisher"
          exec="rqt_publisher"
          name="rqt_publisher" />

    <node pkg="rviz2"
          exec="rviz2"
          name="audibot_test"
          args="-d $(find-pkg-share audibot_gazebo)/rviz/audibot_test.rviz">

        <param name="use_sim_time" value="true" />

    </node>


    <node pkg="vehicle_system" exec="vehicle_control"
          name="vehicle_control" output="screen">
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="vehicle_system" exec="steering_controller"
          name="steering_controller" output="screen">
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="vehicle_system" exec="drive_controller"
          name="drive_controller" output="screen">
        <param name="use_sim_time" value="true" />
    </node>

    <!-- AUROVIA Headlamp System -->
    <node pkg="vehicle_system" exec="light_sensor"
          name="light_sensor" output="screen">
        <param name="use_sim_time" value="true" />
        <param name="light_level" value="100.0" />
    </node>

    <node pkg="vehicle_system" exec="headlamp_controller"
          name="headlamp_controller" output="screen">
        <param name="use_sim_time" value="true" />
    </node>


    <node pkg="vehicle_system" exec="lidar_processor"
          name="lidar_processor" output="screen">
        <param name="use_sim_time" value="true" />
    </node>


    <node pkg="vehicle_system" exec="road_navigator"
          name="road_navigator" output="screen">
        <param name="use_sim_time" value="true" />
        <param name="enabled" value="false" />
    </node>

</launch>
